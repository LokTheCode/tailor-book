QFrame#LoginCard{
    background:rgba(22,25,40,225);
    border-radius:22px;
}

QLabel#Title{
    color:white;
    font-size:30px;
    font-weight:700;
}

QLabel#Subtitle{
    color:#C7CBD5;
    font-size:15px;
}

QLineEdit{
    background:#25293D;
    border:1px solid #3A4055;
    border-radius:10px;
    padding-left:6px;
    color:white;
    font-size:14px;
}

QLineEdit:focus{
    border:2px solid #6D8DFF;
}

QPushButton#LoginButton{
    color:white;
    font-size:16px;
    font-weight:bold;
    border-radius:12px;
    background:qlineargradient(
        x1:0,y1:0,
        x2:1,y2:0,
        stop:0 #3B82F6,
        stop:1 #8B5CF6
    );
}

QPushButton#LoginButton:hover{
    background:#4F46E5;
}