/* ==========================================================
   Dev Tailor ERP - shared theme (dark slate + blue)
   ----------------------------------------------------------
   This is the ONLY stylesheet in the app. It is loaded once in
   main.py (utils/theme.py) and applies to every window.

   Do not call setStyleSheet() on widgets for static styling.
   Give the widget one of the object names below instead:

   Layout         Card, InnerPanel, Sidebar, TopBar, Pagination,
                  TableActions, QuickActions, PageHeader
   Text           PageTitle, PageSubtitle, CardTitle, CardSubtitle,
                  FieldLabel, MutedText, ValueText, AmountText,
                  StatTitle, StatValue, StatDescription
   Buttons        (default = secondary), Primary, Success, Warning,
                  Danger, IconDanger, MenuButton, ChipButton

   Palette
   background  #111827   surface #1F2937   border  #374151
   hover       #273549   text    #F9FAFB   muted   #9CA3AF
   primary     #3B82F6 -> #8B5CF6 (gradient), solid #2563EB
   success #10B981  warning #F59E0B  danger #DC2626
========================================================== */


/* ==========================================================
   Base
========================================================== */

QWidget {
    color: #E5E7EB;
}

QMainWindow,
QDialog,
QMessageBox {
    background: #111827;
}

QLabel,
QCheckBox,
QRadioButton {
    background: transparent;
}

QToolTip {
    background: #1F2937;
    color: #F9FAFB;
    border: 1px solid #374151;
    padding: 6px 8px;
}


/* ==========================================================
   Scroll areas (always transparent, so cards show through)
========================================================== */

QScrollArea,
QScrollArea > QWidget,
QScrollArea > QWidget > QWidget,
QStackedWidget {
    background: transparent;
    border: none;
}

QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 2px;
}

QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 2px;
}

QScrollBar::handle:vertical,
QScrollBar::handle:horizontal {
    background: #374151;
    border-radius: 4px;
    min-height: 30px;
    min-width: 30px;
}

QScrollBar::handle:vertical:hover,
QScrollBar::handle:horizontal:hover {
    background: #4B5563;
}

QScrollBar::add-line,
QScrollBar::sub-line {
    width: 0;
    height: 0;
}

QScrollBar::add-page,
QScrollBar::sub-page {
    background: none;
}


/* ==========================================================
   Page header & text roles
========================================================== */

QWidget#PageHeader,
QFrame#PageHeader {
    background: transparent;
    border: none;
}

QLabel#PageTitle {
    color: #F9FAFB;
    font-size: 28px;
    font-weight: 700;
}

QLabel#PageSubtitle {
    color: #9CA3AF;
    font-size: 14px;
}

QLabel#CardTitle {
    color: #F9FAFB;
    font-size: 18px;
    font-weight: 700;
}

QLabel#CardSubtitle {
    color: #9CA3AF;
    font-size: 12px;
}

QLabel#FieldLabel {
    color: #D1D5DB;
    font-size: 13px;
    font-weight: 600;
}

QLabel#MutedText {
    color: #9CA3AF;
    font-size: 12px;
}

QLabel#ValueText {
    color: #F9FAFB;
    font-size: 14px;
    font-weight: 700;
}

QLabel#AmountText {
    color: #10B981;
    font-size: 20px;
    font-weight: 700;
}


/* ==========================================================
   Cards
========================================================== */

QFrame#Card,
QWidget#Card,
QFrame#QuickActions {
    background: #1F2937;
    border: 1px solid #374151;
    border-radius: 16px;
}

/* A darker panel placed inside a card (summary boxes, list rows) */
QFrame#InnerPanel,
QWidget#InnerPanel {
    background: #111827;
    border: 1px solid #374151;
    border-radius: 12px;
}

/* Read-only info box (selected customer details, etc.) */
QLabel#InfoBox {
    background: #111827;
    color: #CBD5E1;
    border: 1px solid #374151;
    border-radius: 10px;
    padding: 10px;
    font-size: 13px;
}

/* Round customer photo */
QLabel#Avatar {
    background: #111827;
    border: 3px solid #3B82F6;
    border-radius: 70px;
}

QFrame#Separator {
    background: #374151;
    border: none;
    max-height: 1px;
    min-height: 1px;
}


/* ==========================================================
   Stat cards (dashboard, customers, measurements, orders,
   inventory, reports)
========================================================== */

QFrame#StatCard {
    background: #1F2937;
    border: 1px solid #374151;
    border-radius: 16px;
}

QFrame#StatCard:hover {
    background: #273549;
    border: 1px solid #3B82F6;
}

/* Coloured status text, e.g. payment status.
   Set with: label.setProperty("status", "paid"); repolish(label) */
QLabel#StatusText {
    color: #F9FAFB;
    font-size: 20px;
    font-weight: 700;
}

QLabel#StatusText[status="pending"] { color: #EF4444; }
QLabel#StatusText[status="partial"] { color: #F59E0B; }
QLabel#StatusText[status="paid"]    { color: #10B981; }

QLabel#StatTitle {
    color: #9CA3AF;
    font-size: 13px;
    font-weight: 600;
}

QLabel#StatValue {
    color: #F9FAFB;
    font-size: 26px;
    font-weight: 700;
}

QLabel#TrendText {
    color: #22C55E;
    font-size: 13px;
    font-weight: 600;
}

QLabel#StatDescription {
    color: #9CA3AF;
    font-size: 12px;
}


/* ==========================================================
   Inputs
========================================================== */

QLineEdit,
QTextEdit,
QPlainTextEdit,
QComboBox,
QDateEdit,
QSpinBox,
QDoubleSpinBox {
    background: #111827;
    color: #F9FAFB;
    border: 1px solid #374151;
    border-radius: 10px;
    padding: 8px 10px;
    font-size: 13px;
    selection-background-color: #2563EB;
    selection-color: #FFFFFF;
}

QLineEdit,
QComboBox,
QDateEdit,
QSpinBox,
QDoubleSpinBox {
    min-height: 22px;
}

QLineEdit:hover,
QTextEdit:hover,
QPlainTextEdit:hover,
QComboBox:hover,
QDateEdit:hover,
QSpinBox:hover,
QDoubleSpinBox:hover {
    border: 1px solid #4B5563;
}

QLineEdit:focus,
QTextEdit:focus,
QPlainTextEdit:focus,
QComboBox:focus,
QDateEdit:focus,
QSpinBox:focus,
QDoubleSpinBox:focus {
    border: 2px solid #3B82F6;
}

QLineEdit:disabled,
QTextEdit:disabled,
QComboBox:disabled,
QDateEdit:disabled,
QSpinBox:disabled,
QDoubleSpinBox:disabled {
    color: #6B7280;
    background: #0F172A;
}

QLineEdit:read-only {
    color: #CBD5E1;
}

QComboBox::drop-down,
QDateEdit::drop-down {
    border: none;
    width: 28px;
}

QComboBox QAbstractItemView {
    background: #1F2937;
    color: #F9FAFB;
    border: 1px solid #374151;
    outline: none;
    padding: 4px;
    selection-background-color: #2563EB;
    selection-color: #FFFFFF;
}

QSpinBox::up-button,
QSpinBox::down-button,
QDoubleSpinBox::up-button,
QDoubleSpinBox::down-button {
    border: none;
    width: 18px;
}

QCheckBox,
QRadioButton {
    color: #E5E7EB;
    spacing: 8px;
}

/* Calendar popup of QDateEdit */
QCalendarWidget QWidget {
    background: #1F2937;
    color: #F9FAFB;
}

QCalendarWidget QToolButton {
    background: transparent;
    color: #F9FAFB;
    border: none;
    padding: 6px;
    font-weight: 600;
}

QCalendarWidget QToolButton:hover {
    background: #273549;
    border-radius: 6px;
}

QCalendarWidget QAbstractItemView {
    background: #111827;
    color: #E5E7EB;
    selection-background-color: #2563EB;
    selection-color: #FFFFFF;
}

QCalendarWidget QAbstractItemView:disabled {
    color: #4B5563;
}


/* ==========================================================
   Lists
========================================================== */

QListWidget {
    background: #111827;
    color: #F9FAFB;
    border: 1px solid #374151;
    border-radius: 10px;
    padding: 6px;
    outline: none;
}

QListWidget::item {
    color: #E5E7EB;
    padding: 10px;
    border-radius: 8px;
    margin: 2px 0;
}

QListWidget::item:hover {
    background: #273549;
}

QListWidget::item:selected {
    background: #2563EB;
    color: #FFFFFF;
}


/* ==========================================================
   Tables
========================================================== */

QTableWidget,
QTableView {
    background: #1F2937;
    alternate-background-color: #1A2332;
    color: #F9FAFB;
    border: none;
    gridline-color: #374151;
    font-size: 13px;
    selection-background-color: #2563EB;
    selection-color: #FFFFFF;
    outline: none;
}

QTableWidget::item,
QTableView::item {
    padding: 6px;
}

QHeaderView {
    background: transparent;
}

QHeaderView::section {
    background: #111827;
    color: #D1D5DB;
    border: none;
    border-bottom: 1px solid #374151;
    padding: 10px 8px;
    font-size: 12px;
    font-weight: 700;
}

QTableCornerButton::section {
    background: #111827;
    border: none;
}


/* ==========================================================
   Buttons
   Default QPushButton = secondary (dark with border)
========================================================== */

QPushButton {
    background: #1F2937;
    color: #F9FAFB;
    border: 1px solid #374151;
    border-radius: 10px;
    padding: 9px 16px;
    font-size: 13px;
    font-weight: 600;
}

QPushButton:hover {
    background: #273549;
    border: 1px solid #3B82F6;
}

QPushButton:pressed {
    background: #111827;
}

QPushButton:disabled {
    background: #0F172A;
    color: #6B7280;
    border: 1px solid #1F2937;
}

QPushButton#Primary {
    color: #FFFFFF;
    border: none;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #3B82F6, stop:1 #8B5CF6);
}

QPushButton#Primary:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #2563EB, stop:1 #7C3AED);
}

QPushButton#Primary:pressed {
    background: #1D4ED8;
}

QPushButton#Success {
    color: #FFFFFF;
    border: none;
    background: #10B981;
}

QPushButton#Success:hover {
    background: #059669;
}

QPushButton#Warning {
    color: #FFFFFF;
    border: none;
    background: #F59E0B;
}

QPushButton#Warning:hover {
    background: #D97706;
}

QPushButton#Danger {
    color: #FFFFFF;
    border: none;
    background: #DC2626;
}

QPushButton#Danger:hover {
    background: #B91C1C;
}

QPushButton#Primary:disabled,
QPushButton#Success:disabled,
QPushButton#Warning:disabled,
QPushButton#Danger:disabled {
    background: #374151;
    color: #9CA3AF;
}

/* Small toggle-style buttons (quick tags, % presets) */
QPushButton#ChipButton {
    background: #111827;
    border: 1px solid #374151;
    border-radius: 14px;
    padding: 6px 14px;
    font-size: 12px;
}

QPushButton#ChipButton:hover,
QPushButton#ChipButton:checked {
    background: #2563EB;
    border: 1px solid #3B82F6;
    color: #FFFFFF;
}


/* ==========================================================
   Square icon buttons inside table rows
========================================================== */

QWidget#TableActions {
    background: transparent;
    border: none;
}

QWidget#TableActions QPushButton {
    background: #111827;
    border: 1px solid #374151;
    border-radius: 8px;
    padding: 0 8px;
    min-width: 16px;
    min-height: 30px;
    max-height: 30px;
    font-size: 12px;
}

QWidget#TableActions QPushButton:hover {
    background: #2563EB;
    border: 1px solid #3B82F6;
}

QWidget#TableActions QPushButton#IconDanger:hover {
    background: #DC2626;
    border: 1px solid #EF4444;
}


/* ==========================================================
   Pagination bars
========================================================== */

QFrame#Pagination {
    background: #1F2937;
    border: 1px solid #374151;
    border-radius: 16px;
}

QFrame#Pagination QPushButton {
    background: #111827;
    border: 1px solid #374151;
    border-radius: 8px;
    padding: 0 10px;
    min-width: 36px;
    min-height: 36px;
}

QFrame#Pagination QPushButton:hover {
    background: #2563EB;
    border: 1px solid #3B82F6;
}

QFrame#Pagination QPushButton:disabled {
    background: #0F172A;
    color: #6B7280;
    border: 1px solid #374151;
}

QFrame#Pagination QComboBox {
    padding: 4px 8px;
    min-width: 70px;
}


/* ==========================================================
   Dashboard quick actions
========================================================== */

QFrame#QuickActions QPushButton {
    background: #111827;
    border: 1px solid #374151;
    border-radius: 14px;
    padding: 18px;
    font-size: 14px;
    text-align: left;
}

QFrame#QuickActions QPushButton:hover {
    border: 1px solid #3B82F6;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 #3B82F6, stop:1 #8B5CF6);
}


/* ==========================================================
   Sidebar
========================================================== */

QWidget#Sidebar {
    background: #0F172A;
    border-right: 1px solid #1F2937;
}

QLabel#SidebarLogo {
    color: #FFFFFF;
    font-size: 22px;
    font-weight: 700;
    padding: 20px;
}

QPushButton#MenuButton {
    background: transparent;
    color: #D1D5DB;
    border: none;
    text-align: left;
    padding: 14px 20px;
    font-size: 15px;
    font-weight: 500;
    border-radius: 10px;
}

QPushButton#MenuButton:hover {
    background: #1F2937;
    color: #FFFFFF;
}

QPushButton#MenuButton[active="true"] {
    color: #FFFFFF;
    font-weight: 700;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #3B82F6, stop:1 #8B5CF6);
}


/* ==========================================================
   Top bar
========================================================== */

QWidget#TopBar {
    background: #111827;
    border-bottom: 1px solid #1F2937;
}

QLabel#TopBarTitle {
    color: #FFFFFF;
    font-size: 24px;
    font-weight: 700;
}

QLabel#TopBarDate {
    color: #9CA3AF;
    font-size: 14px;
}

QLineEdit#TopBarSearch {
    background: #1F2937;
    border-radius: 10px;
    padding-left: 10px;
    font-size: 14px;
}


/* ==========================================================
   Login window
========================================================== */

QFrame#LoginOverlay {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 rgba(20, 35, 90, 180),
                                stop:1 rgba(90, 30, 150, 180));
}

QFrame#LoginCard {
    background: rgba(22, 25, 40, 225);
    border: none;
    border-radius: 22px;
}

QFrame#LoginCard QLineEdit {
    background: #25293D;
    border: 1px solid #3A4055;
    border-radius: 10px;
    padding-left: 6px;
    color: #FFFFFF;
    font-size: 14px;
}

QFrame#LoginCard QLineEdit:focus {
    border: 2px solid #3B82F6;
}

QLabel#LoginTitle {
    color: #FFFFFF;
    font-size: 30px;
    font-weight: 700;
}

QLabel#LoginSubtitle {
    color: #C7CBD5;
    font-size: 15px;
}

QLabel#LoginDivider {
    color: #9096A5;
    font-size: 14px;
}

QLabel#LoginFooter {
    color: #C8CDD9;
    font-size: 13px;
}

QLabel#LoginLink {
    color: #6D8DFF;
    font-size: 13px;
}

QPushButton#LoginButton {
    color: #FFFFFF;
    font-size: 16px;
    font-weight: 700;
    border: none;
    border-radius: 12px;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #3B82F6, stop:1 #8B5CF6);
}

QPushButton#LoginButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #2563EB, stop:1 #7C3AED);
}

QPushButton#SocialButton {
    border: none;
    border-radius: 24px;
    padding: 0;
}

QPushButton#SocialButton:hover {
    background: #FFFFFF;
}

QPushButton#SocialButton[brand="facebook"]  { background: #1877F2; }
QPushButton#SocialButton[brand="instagram"] { background: #E4405F; }
QPushButton#SocialButton[brand="linkedin"]  { background: #0A66C2; }
QPushButton#SocialButton[brand="website"]   { background: #10B981; }

QPushButton#SocialButton[brand="facebook"]:hover,
QPushButton#SocialButton[brand="instagram"]:hover,
QPushButton#SocialButton[brand="linkedin"]:hover,
QPushButton#SocialButton[brand="website"]:hover {
    background: #273549;
}


/* ==========================================================
   Charts
========================================================== */

QChartView {
    background: transparent;
    border: none;
}


/* ==========================================================
   Square icon-only button (toolbar bell, etc.)
========================================================== */

QPushButton#IconButton {
    padding: 0;
    border-radius: 10px;
}
