/* ==========================================================
   Tailor Book - shared stylesheet
   ----------------------------------------------------------
   This is the ONLY stylesheet in the app. utils/theme.py loads it
   once and replaces every @name below with the colour of the chosen
   theme (Settings > Appearance). Add new themes in utils/theme.py,
   not here.

   Do not call setStyleSheet() on widgets for static styling.
   Give the widget one of the object names below instead:

   Layout         Card, InnerPanel, Sidebar, TopBar, Pagination,
                  TableActions, QuickActions, PageHeader
   Text           PageTitle, PageSubtitle, CardTitle, CardSubtitle,
                  FieldLabel, MutedText, ValueText, AmountText,
                  StatTitle, StatValue, StatDescription
   Buttons        (default = secondary), Primary, Success, Warning,
                  Danger, IconDanger, MenuButton, ChipButton

   Colour roles
   @bg @surface @border @border_strong @hover @disabled_bg
   @text @text_soft @text_label @text_info @muted @faint
   @row_alt @row_line @row_hover @row_selected @selected_text
   @sidebar_bg @sidebar_hover @sidebar_text @sidebar_strong @topbar_bg
   @accent_start @accent_end @accent @accent_end_hover @accent_pressed
   @on_accent @success_text @warning_text @danger_text
========================================================== */


/* ==========================================================
   Base
========================================================== */

QWidget {
    color: @text_soft;
}

QMainWindow,
QDialog,
QMessageBox {
    background: @bg;
}

QLabel,
QCheckBox,
QRadioButton {
    background: transparent;
}

QToolTip {
    background: @surface;
    color: @text;
    border: 1px solid @border;
    padding: 6px 8px;
}


/* ==========================================================
   Scroll areas (always transparent, so cards show through)
========================================================== */

QScrollArea,
QScrollArea > QWidget,
QScrollArea > QWidget > QWidget,
QStackedWidget {
    background: transparent;
    border: none;
}

QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 2px;
}

QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 2px;
}

QScrollBar::handle:vertical,
QScrollBar::handle:horizontal {
    background: @border;
    border-radius: 4px;
    min-height: 30px;
    min-width: 30px;
}

QScrollBar::handle:vertical:hover,
QScrollBar::handle:horizontal:hover {
    background: @border_strong;
}

QScrollBar::add-line,
QScrollBar::sub-line {
    width: 0;
    height: 0;
}

QScrollBar::add-page,
QScrollBar::sub-page {
    background: none;
}


/* ==========================================================
   Page header & text roles
========================================================== */

QWidget#PageHeader,
QFrame#PageHeader {
    background: transparent;
    border: none;
}

QLabel#PageTitle {
    color: @text;
    font-size: 28px;
    font-weight: 700;
}

QLabel#PageSubtitle {
    color: @muted;
    font-size: 14px;
}

QLabel#CardTitle {
    color: @text;
    font-size: 18px;
    font-weight: 700;
}

QLabel#CardSubtitle {
    color: @muted;
    font-size: 12px;
}

QLabel#FieldLabel {
    color: @text_label;
    font-size: 13px;
    font-weight: 600;
}

QLabel#MutedText {
    color: @muted;
    font-size: 12px;
}

QLabel#ValueText {
    color: @text;
    font-size: 14px;
    font-weight: 700;
}

QLabel#AmountText {
    color: @success_text;
    font-size: 20px;
    font-weight: 700;
}


/* ==========================================================
   Cards
========================================================== */

QFrame#Card,
QWidget#Card,
QFrame#QuickActions {
    background: @surface;
    border: 1px solid @border;
    border-radius: 16px;
}

/* A darker panel placed inside a card (summary boxes, list rows) */
QFrame#InnerPanel,
QWidget#InnerPanel {
    background: @bg;
    border: 1px solid @border;
    border-radius: 12px;
}

/* Read-only info box (selected customer details, etc.) */
QLabel#InfoBox {
    background: @bg;
    color: @text_info;
    border: 1px solid @border;
    border-radius: 10px;
    padding: 10px;
    font-size: 13px;
}

/* Round customer photo */
QLabel#Avatar {
    background: @bg;
    border: 3px solid @accent_start;
    border-radius: 70px;
}

QFrame#Separator {
    background: @border;
    border: none;
    max-height: 1px;
    min-height: 1px;
}


/* ==========================================================
   Stat cards (dashboard, customers, measurements, orders,
   inventory, reports)
========================================================== */

QFrame#StatCard {
    background: @surface;
    border: 1px solid @border;
    border-radius: 16px;
}

QFrame#StatCard:hover {
    background: @hover;
    border: 1px solid @accent_start;
}

/* Coloured status text, e.g. payment status.
   Set with: label.setProperty("status", "paid"); repolish(label) */
QLabel#StatusText {
    color: @text;
    font-size: 20px;
    font-weight: 700;
}

QLabel#StatusText[status="pending"] { color: @danger_text; }
QLabel#StatusText[status="partial"] { color: @warning_text; }
QLabel#StatusText[status="paid"]    { color: @success_text; }

QLabel#StatTitle {
    color: @muted;
    font-size: 13px;
    font-weight: 600;
}

QLabel#StatValue {
    color: @text;
    font-size: 26px;
    font-weight: 700;
}

QLabel#TrendText {
    color: @success_text;
    font-size: 13px;
    font-weight: 600;
}

QLabel#StatDescription {
    color: @muted;
    font-size: 12px;
}


/* ==========================================================
   Inputs
========================================================== */

QLineEdit,
QTextEdit,
QPlainTextEdit,
QComboBox,
QDateEdit,
QSpinBox,
QDoubleSpinBox {
    background: @bg;
    color: @text;
    border: 1px solid @border;
    border-radius: 10px;
    padding: 8px 10px;
    font-size: 13px;
    selection-background-color: @accent;
    selection-color: @on_accent;
}

QLineEdit,
QComboBox,
QDateEdit,
QSpinBox,
QDoubleSpinBox {
    min-height: 22px;
}

QLineEdit:hover,
QTextEdit:hover,
QPlainTextEdit:hover,
QComboBox:hover,
QDateEdit:hover,
QSpinBox:hover,
QDoubleSpinBox:hover {
    border: 1px solid @border_strong;
}

QLineEdit:focus,
QTextEdit:focus,
QPlainTextEdit:focus,
QComboBox:focus,
QDateEdit:focus,
QSpinBox:focus,
QDoubleSpinBox:focus {
    border: 2px solid @accent_start;
}

QLineEdit:disabled,
QTextEdit:disabled,
QComboBox:disabled,
QDateEdit:disabled,
QSpinBox:disabled,
QDoubleSpinBox:disabled {
    color: @faint;
    background: @disabled_bg;
}

QLineEdit:read-only {
    color: @text_info;
}

QComboBox::drop-down,
QDateEdit::drop-down {
    border: none;
    width: 28px;
}

QComboBox QAbstractItemView {
    background: @surface;
    color: @text;
    border: 1px solid @border;
    outline: none;
    padding: 4px;
    selection-background-color: @accent;
    selection-color: @on_accent;
}

QSpinBox::up-button,
QSpinBox::down-button,
QDoubleSpinBox::up-button,
QDoubleSpinBox::down-button {
    border: none;
    width: 18px;
}

QCheckBox,
QRadioButton {
    color: @text_soft;
    spacing: 8px;
}

/* Calendar popup of QDateEdit */
QCalendarWidget QWidget {
    background: @surface;
    color: @text;
}

QCalendarWidget QToolButton {
    background: transparent;
    color: @text;
    border: none;
    padding: 6px;
    font-weight: 600;
}

QCalendarWidget QToolButton:hover {
    background: @hover;
    border-radius: 6px;
}

QCalendarWidget QAbstractItemView {
    background: @bg;
    color: @text_soft;
    selection-background-color: @accent;
    selection-color: @on_accent;
}

QCalendarWidget QAbstractItemView:disabled {
    color: @border_strong;
}


/* ==========================================================
   Lists
========================================================== */

QListWidget {
    background: @bg;
    color: @text;
    border: 1px solid @border;
    border-radius: 10px;
    padding: 6px;
    outline: none;
}

QListWidget::item {
    color: @text_soft;
    padding: 8px 10px;
    border: none;
    border-radius: 8px;
}

QListWidget::item:hover {
    background: @hover;
}

QListWidget::item:selected {
    background: @accent;
    color: @on_accent;
}

/* Settings section menu: no inner box, just the items */
QListWidget#SettingsMenu {
    background: transparent;
    border: none;
    padding: 0;
}

QListWidget#SettingsMenu::item {
    padding: 0 12px;
    font-size: 14px;
}

QListWidget#SettingsMenu::item:selected {
    font-weight: 600;
}


/* ==========================================================
   Tables
========================================================== */

QTableWidget,
QTableView {
    background: @surface;
    alternate-background-color: @row_alt;
    color: @text;
    border: none;
    gridline-color: @row_line;
    font-size: 13px;
    selection-background-color: @row_selected;
    selection-color: @selected_text;
    outline: none;
}

QTableWidget::item,
QTableView::item {
    padding: 0 10px;
    border: none;
    border-bottom: 1px solid @row_line;
}

QTableWidget::item:hover,
QTableView::item:hover {
    background: @row_hover;
}

QTableWidget::item:selected,
QTableView::item:selected {
    background: @row_selected;
    color: @selected_text;
}

QHeaderView {
    background: transparent;
    border: none;
}

QHeaderView::section {
    background: @bg;
    color: @text_label;
    border: none;
    border-bottom: 2px solid @border;
    padding: 0 10px;
    font-size: 12px;
    font-weight: 700;
}

QTableCornerButton::section {
    background: @bg;
    border: none;
}


/* ==========================================================
   Buttons
   Default QPushButton = secondary (dark with border)
========================================================== */

QPushButton {
    background: @surface;
    color: @text;
    border: 1px solid @border;
    border-radius: 10px;
    padding: 9px 16px;
    font-size: 13px;
    font-weight: 600;
}

QPushButton:hover {
    background: @hover;
    border: 1px solid @accent_start;
}

QPushButton:pressed {
    background: @bg;
}

QPushButton:disabled {
    background: @disabled_bg;
    color: @faint;
    border: 1px solid @surface;
}

QPushButton#Primary {
    color: @on_accent;
    border: none;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 @accent_start, stop:1 @accent_end);
}

QPushButton#Primary:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 @accent, stop:1 @accent_end_hover);
}

QPushButton#Primary:pressed {
    background: @accent_pressed;
}

QPushButton#Success {
    color: @on_accent;
    border: none;
    background: #10B981;
}

QPushButton#Success:hover {
    background: #059669;
}

QPushButton#Warning {
    color: @on_accent;
    border: none;
    background: #F59E0B;
}

QPushButton#Warning:hover {
    background: #D97706;
}

QPushButton#Danger {
    color: @on_accent;
    border: none;
    background: #DC2626;
}

QPushButton#Danger:hover {
    background: #B91C1C;
}

QPushButton#Primary:disabled,
QPushButton#Success:disabled,
QPushButton#Warning:disabled,
QPushButton#Danger:disabled {
    background: @border;
    color: @muted;
}

/* Small toggle-style buttons (quick tags, % presets) */
QPushButton#ChipButton {
    background: @bg;
    border: 1px solid @border;
    border-radius: 14px;
    padding: 6px 14px;
    font-size: 12px;
}

QPushButton#ChipButton:hover,
QPushButton#ChipButton:checked {
    background: @accent;
    border: 1px solid @accent_start;
    color: @on_accent;
}


/* ==========================================================
   Square icon buttons inside table rows
========================================================== */

QWidget#TableActions {
    background: transparent;
    border: none;
}

QWidget#TableActions QPushButton {
    background: @bg;
    border: 1px solid @border;
    border-radius: 8px;
    padding: 0 8px;
    min-width: 16px;
    min-height: 30px;
    max-height: 30px;
    font-size: 12px;
}

QWidget#TableActions QPushButton:hover {
    background: @accent;
    border: 1px solid @accent_start;
}

QWidget#TableActions QPushButton#IconDanger:hover {
    background: #DC2626;
    border: 1px solid #EF4444;
}


/* ==========================================================
   Pagination bars
========================================================== */

QFrame#Pagination {
    background: @surface;
    border: 1px solid @border;
    border-radius: 16px;
}

QFrame#Pagination QPushButton {
    background: @bg;
    border: 1px solid @border;
    border-radius: 8px;
    padding: 0 10px;
    min-width: 36px;
    min-height: 36px;
}

QFrame#Pagination QPushButton:hover {
    background: @accent;
    border: 1px solid @accent_start;
}

QFrame#Pagination QPushButton:disabled {
    background: @disabled_bg;
    color: @faint;
    border: 1px solid @border;
}

QFrame#Pagination QComboBox {
    padding: 4px 8px;
    min-width: 70px;
}


/* ==========================================================
   Dashboard quick actions
========================================================== */

QFrame#QuickActions QPushButton {
    background: @bg;
    border: 1px solid @border;
    border-radius: 14px;
    padding: 18px;
    font-size: 14px;
    text-align: left;
}

QFrame#QuickActions QPushButton:hover {
    border: 1px solid @accent_start;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 @accent_start, stop:1 @accent_end);
}


/* ==========================================================
   Sidebar
========================================================== */

QWidget#Sidebar {
    background: @sidebar_bg;
    border-right: 1px solid @sidebar_hover;
}

QLabel#SidebarLogo {
    color: @sidebar_strong;
    font-size: 16px;
    font-weight: 700;
}

QLabel#SidebarProduct {
    color: @sidebar_text;
    font-size: 11px;
}

QPushButton#MenuButton {
    background: transparent;
    color: @sidebar_text;
    border: none;
    text-align: left;
    padding: 14px 20px;
    font-size: 15px;
    font-weight: 500;
    border-radius: 10px;
}

QPushButton#MenuButton:hover {
    background: @sidebar_hover;
    color: @sidebar_strong;
}

QPushButton#MenuButton[active="true"] {
    color: @sidebar_strong;
    font-weight: 700;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 @accent_start, stop:1 @accent_end);
}


/* ==========================================================
   Top bar
========================================================== */

QWidget#TopBar {
    background: @topbar_bg;
    border-bottom: 1px solid @border;
}

QLabel#TopBarTitle {
    color: @text;
    font-size: 24px;
    font-weight: 700;
}

QLabel#TopBarDate {
    color: @muted;
    font-size: 14px;
}

QLineEdit#TopBarSearch {
    background: @surface;
    border-radius: 10px;
    padding-left: 10px;
    font-size: 14px;
}


/* ==========================================================
   Login window
========================================================== */

QFrame#LoginOverlay {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 rgba(20, 35, 90, 180),
                                stop:1 rgba(90, 30, 150, 180));
}

QFrame#LoginCard {
    background: rgba(22, 25, 40, 225);
    border: none;
    border-radius: 22px;
}

QFrame#LoginCard QLineEdit {
    background: #25293D;
    border: 1px solid #3A4055;
    border-radius: 10px;
    padding-left: 6px;
    color: #FFFFFF;
    font-size: 14px;
}

QFrame#LoginCard QLineEdit:focus {
    border: 2px solid @accent_start;
}

QLabel#LoginTitle {
    color: #FFFFFF;
    font-size: 30px;
    font-weight: 700;
}

QLabel#LoginSubtitle {
    color: #C7CBD5;
    font-size: 15px;
}

QLabel#LoginDivider {
    color: #9096A5;
    font-size: 14px;
}

QLabel#LoginFooter {
    color: #C8CDD9;
    font-size: 13px;
}

QLabel#LoginLink {
    color: #6D8DFF;
    font-size: 13px;
}

QPushButton#LoginButton {
    color: #FFFFFF;
    font-size: 16px;
    font-weight: 700;
    border: none;
    border-radius: 12px;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 @accent_start, stop:1 @accent_end);
}

QPushButton#LoginButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 @accent, stop:1 @accent_end_hover);
}

QFrame#LoginCard QCheckBox {
    color: #FFFFFF;
}

QPushButton#SocialButton {
    border: none;
    border-radius: 24px;
    padding: 0;
}

QPushButton#SocialButton:hover {
    background: #FFFFFF;
}

QPushButton#SocialButton[brand="facebook"]  { background: #1877F2; }
QPushButton#SocialButton[brand="instagram"] { background: #E4405F; }
QPushButton#SocialButton[brand="linkedin"]  { background: #0A66C2; }
QPushButton#SocialButton[brand="website"]   { background: #10B981; }

QPushButton#SocialButton[brand="facebook"]:hover,
QPushButton#SocialButton[brand="instagram"]:hover,
QPushButton#SocialButton[brand="linkedin"]:hover,
QPushButton#SocialButton[brand="website"]:hover {
    background: #273549;
}


/* ==========================================================
   Menus (profile menu, context menus)
========================================================== */

QMenu {
    background: @surface;
    color: @text;
    border: 1px solid @border;
    border-radius: 10px;
    padding: 6px;
}

QMenu::item {
    padding: 8px 24px 8px 12px;
    border-radius: 6px;
}

QMenu::item:selected {
    background: @accent;
    color: @on_accent;
}

QMenu::separator {
    height: 1px;
    background: @border;
    margin: 6px 4px;
}

QMenu::icon {
    padding-left: 8px;
}

QPushButton::menu-indicator {
    subcontrol-position: right center;
    subcontrol-origin: padding;
    right: 8px;
}

QPushButton#Primary[hasMenu="true"] {
    padding-right: 28px;
}


/* ==========================================================
   Progress bar
========================================================== */

QProgressBar {
    background: @bg;
    border: 1px solid @border;
    border-radius: 8px;
    height: 14px;
    text-align: center;
    color: @text;
    font-size: 11px;
}

QProgressBar::chunk {
    border-radius: 7px;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 @accent_start, stop:1 @accent_end);
}


/* ==========================================================
   Charts
========================================================== */

QChartView {
    background: transparent;
    border: none;
}


/* ==========================================================
   Square icon-only button (toolbar bell, etc.)
========================================================== */

QPushButton#IconButton {
    padding: 0;
    border-radius: 10px;
}


/* ==========================================================
   Settings > Appearance: theme tiles and accent swatches
========================================================== */

QToolButton#ThemeTile {
    background: @surface;
    color: @text;
    border: 2px solid @border;
    border-radius: 14px;
    padding: 10px;
    font-size: 13px;
    font-weight: 600;
}

QToolButton#ThemeTile:hover {
    border: 2px solid @border_strong;
    background: @hover;
}

QToolButton#ThemeTile:checked {
    border: 2px solid @accent_start;
    background: @hover;
}

QToolButton#AccentSwatch {
    background: transparent;
    color: @text_label;
    border: 2px solid transparent;
    border-radius: 12px;
    padding: 4px;
    font-size: 11px;
}

QToolButton#AccentSwatch:hover {
    background: @hover;
}

QToolButton#AccentSwatch:checked {
    border: 2px solid @text;
    background: @hover;
}
